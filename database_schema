 `meesho_commission_perc` decimal(5,2) DEFAULT 0.00,
 `meesho_commission` decimal(12,2) DEFAULT 0.00,
 `meesho_gold_platform_fee` decimal(12,2) DEFAULT 0.00,
 `meesho_mall_platform_fee` decimal(12,2) DEFAULT 0.00,
 `fixed_fee2` decimal(12,2) DEFAULT 0.00,
 `warehousing_fee2` decimal(12,2) DEFAULT 0.00,
 `return_shipping_charge` decimal(12,2) DEFAULT 0.00,
 `gst_compensation` decimal(12,2) DEFAULT 0.00,
 `shipping_charge` decimal(12,2) DEFAULT 0.00,
 `other_support_service` decimal(12,2) DEFAULT 0.00,
 `waivers` decimal(12,2) DEFAULT 0.00,
