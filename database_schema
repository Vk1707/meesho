 `admin_id` int(10) unsigned NOT NULL,
 `deduction_duration` date DEFAULT NULL,
 `deduction_date` date DEFAULT NULL,
 `campaign_id` varchar(50) DEFAULT NULL,
 `ad_cost` decimal(12,2) DEFAULT 0.00,
 `credits_waivers_discounts` decimal(12,2) DEFAULT 0.00,
 `ad_cost_incl` decimal(12,2) DEFAULT 0.00,
